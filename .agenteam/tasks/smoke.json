{
  "schema": "mellonelay.agenteam.task.v1",
  "task_id": "smoke-agenteam-runtime-v1",
  "repository": "Mellonelay/IPBL",
  "working_directory": "/root/repos/IPBL-worktrees/agenteam-fabric-runtime-v1",
  "objective": "Verify the repository A-team execution runtime without changing application code.",
  "workflow": [
    "researcher",
    "pm",
    "architect",
    "dev",
    "qa",
    "reviewer"
  ],
  "allow_dirty": false,
  "authorizations": {},
  "roles": {
    "researcher": {
      "command": "git status --short --branch",
      "allowed_paths": []
    },
    "pm": {
      "command": "test -f AGENTS.md",
      "allowed_paths": []
    },
    "architect": {
      "command": "python3 -m json.tool .agenteam/config.yaml >/dev/null",
      "allowed_paths": []
    },
    "dev": {
      "command": "python3 -m py_compile scripts/agenteam_runner.py scripts/agenteam_orchestrate.py",
      "allowed_paths": []
    },
    "qa": {
      "command": "python3 scripts/test_zero_drift_kernel_v2.py",
      "allowed_paths": []
    },
    "reviewer": {
      "command": "git diff --check",
      "allowed_paths": []
    }
  }
}
