[Unit]
Description=IPBL recorder source-health transition monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/ipbl-recorder-monitor.env
ExecStart=/usr/local/sbin/ipbl-recorder-monitor
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=ipbl-recorder-monitor
StateDirectoryMode=0700
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
