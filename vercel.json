{
  "version": 2,
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/results/live",
      "destination": "/api/results/live.ts"
    },
    {
      "source": "/api/results",
      "destination": "/api/results.ts"
    },
    {
      "source": "/api/admin/backfill-results",
      "destination": "/api/admin/backfill-results.ts"
    },
    {
      "source": "/api/backtest",
      "destination": "/api/backtest.ts"
    },
    {
      "source": "/api/gen-analysis",
      "destination": "/api/gen-analysis.ts"
    },
    {
      "source": "/api/cron/sync-results",
      "destination": "/api/cron/cron-sync-results.ts"
    },
    {
      "source": "/api/cron/record-live",
      "destination": "/api/cron/record-live.ts"
    },
    {
      "source": "/api/teams/history",
      "destination": "/api/teams/history.ts"
    },
    {
      "source": "/api/ipbl/games/game",
      "destination": "/api/ipbl/games/game.ts"
    },
    {
      "source": "/api/ipbl/box-score",
      "destination": "/api/ipbl/box-score.ts"
    },
    {
      "source": "/api/ipbl/team/games",
      "destination": "/api/ipbl/team/games.ts"
    },
    {
      "source": "/api/recorder/status",
      "destination": "/api/recorder/status.ts"
    },
    {
      "source": "/api/recorder/history",
      "destination": "/api/recorder/history.ts"
    },
    {
      "source": "/api/ipbl/(.*)",
      "destination": "https://worker.mloneslot99.com/ipbl-proxy/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/record-live",
      "schedule": "0 0 * * *"
    }
  ]
}
